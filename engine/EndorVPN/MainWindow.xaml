<Window x:Class="EndorVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EndorVPN"
        Width="470" Height="860"
        MinWidth="430" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DropShadowEffect x:Key="WindowShadow" Color="#000000" BlurRadius="34" ShadowDepth="0" Opacity="0.55"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootShell" CornerRadius="14" Background="#070B16" BorderBrush="#1B2540" BorderThickness="1"
            Effect="{StaticResource WindowShadow}" ClipToBounds="True">
        <Grid x:Name="RootGrid">
            <!-- background glows -->
            <Grid x:Name="BackdropLayer" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse x:Name="TopGlow" Width="620" Height="420" HorizontalAlignment="Center" VerticalAlignment="Top"
                         Margin="0,-210,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#5A3B82F6" Offset="0"/>
                            <GradientStop Color="#0A3B82F6" Offset="0.65"/>
                            <GradientStop Color="#003B82F6" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="SideGlow" Width="460" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,40,-200,0" Opacity="0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3322D3EE" Offset="0"/>
                            <GradientStop Color="#0022D3EE" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ============ title bar ============ -->
                <Border Grid.Row="0" x:Name="TitleBar" Height="54" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="16,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="9" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2E3B82F6" Offset="0"/>
                                        <GradientStop Color="#1E22D3EE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#4D78AAFF"/>
                                </Border.BorderBrush>
                                <Border BorderThickness="1">
                                    <Path Data="M12 2.6 3.8 5.9v5.5c0 5 3.5 9.6 8.2 10.9 4.7-1.3 8.2-5.9 8.2-10.9V5.9L12 2.6Z"
                                          Fill="#7DB3FF" Stretch="Uniform" Width="17" Height="17"/>
                                </Border>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="EndorVPN" FontSize="15" FontWeight="Bold" Foreground="#EAF0FF"/>
                                <TextBlock x:Name="TaglineText" FontSize="10.5" Foreground="#64718E" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border x:Name="LangSwitch" CornerRadius="9" Background="#0DFFFFFF" BorderBrush="#1B2540"
                                    BorderThickness="1" Padding="2" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnRu" Content="RU" Style="{DynamicResource SegButton}" Click="BtnRu_Click"/>
                                    <Button x:Name="BtnEn" Content="EN" Style="{DynamicResource SegButton}" Click="BtnEn_Click"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnSettings" Style="{DynamicResource IconButton}" Click="BtnSettings_Click" ToolTip="Настройки">
                                <Path Data="M19.4 13a7.9 7.9 0 0 0 .05-.98c0-.33-.02-.66-.06-.99l2.1-1.64a.5.5 0 0 0 .12-.64l-2-3.46a.5.5 0 0 0-.6-.22l-2.48 1a7.3 7.3 0 0 0-1.7-1l-.38-2.64A.5.5 0 0 0 13.96 2h-4a.5.5 0 0 0-.5.42L9.1 5.07c-.6.25-1.17.58-1.7.98L4.9 5.06a.5.5 0 0 0-.6.22l-2 3.46a.5.5 0 0 0 .12.64l2.1 1.65c-.04.33-.06.66-.06.99 0 .33.02.66.06.98l-2.1 1.65a.5.5 0 0 0-.12.64l2 3.46c.13.22.38.31.6.22l2.48-1c.53.4 1.1.73 1.7.98l.36 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65a7.3 7.3 0 0 0 1.7-.98l2.48 1c.22.09.47 0 .6-.22l2-3.46a.5.5 0 0 0-.12-.64L19.4 13ZM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Z"
                                      Fill="#93A0BD" Width="17" Height="17" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="BtnMinimize" Style="{DynamicResource IconButton}" Click="BtnMinimize_Click" ToolTip="Свернуть">
                                <Path Data="M5 11h14v2H5z" Fill="#93A0BD" Width="15" Height="15" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="BtnClose" Style="{DynamicResource IconButtonClose}" Click="BtnClose_Click" ToolTip="Закрыть">
                                <Path Data="m6.4 5 5.6 5.6L17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19 5 17.6 10.6 12 5 6.4 6.4 5Z"
                                      Fill="#93A0BD" Width="15" Height="15" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ main content ============ -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- hero -->
                    <StackPanel Grid.Row="0" x:Name="HeroPanel" Margin="22,2,22,14">
                        <Border x:Name="StatusPill" HorizontalAlignment="Center" CornerRadius="14" Background="#0AFFFFFF"
                                BorderBrush="#1B2540" BorderThickness="1" Padding="10,4,12,4" MinHeight="27">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#64718E" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="12.5" Foreground="#93A0BD" VerticalAlignment="Center"/>
                                <Border x:Name="StatusLocSep" Width="1" Height="13" Background="#1B2540" Margin="9,0,9,0" Visibility="Collapsed"/>
                                <StackPanel x:Name="StatusLocPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Image x:Name="StatusLocFlag" Width="17" Height="12.75" VerticalAlignment="Center">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,17,12.75" RadiusX="2" RadiusY="2"/>
                                        </Image.Clip>
                                    </Image>
                                    <TextBlock x:Name="StatusLocName" Margin="6,0,0,0" FontSize="12.5" Foreground="#EAF0FF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- power button -->
                        <Grid Height="118" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button x:Name="PowerButton" Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Style="{DynamicResource PowerButton}" Click="PowerButton_Click">
                                <Grid>
                                    <Ellipse x:Name="PowerRingEllipse" Width="106" Height="106">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#2E3B82F6" Offset="0"/>
                                                <GradientStop Color="#E60D1426" Offset="0.72"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse x:Name="PowerRingBorder" Width="106" Height="106" Stroke="#3D78AAFF" StrokeThickness="1.5">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="PowerGlowEffect" Color="#3B82F6" BlurRadius="34" ShadowDepth="0" Opacity="0.55"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Path x:Name="PowerIcon" Data="M12 3v8M6.7 6.9a7.5 7.5 0 1 0 10.6 0" Stroke="#7DB3FF" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="34" Height="34" Stretch="Uniform"/>
                                </Grid>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="PowerHint" HorizontalAlignment="Center" FontSize="12" Foreground="#64718E" Margin="0,4,0,12"/>

                        <!-- ip card -->
                        <Border CornerRadius="10" Background="#0AFFFFFF" BorderBrush="#1B2540" BorderThickness="1" Padding="13,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="RealIpLabel" FontSize="9.5" Foreground="#64718E" Text="ВАШ IP"/>
                                    <TextBlock x:Name="RealIpText" FontSize="14.5" FontWeight="SemiBold" Foreground="#EAF0FF" Margin="0,2,0,0"
                                               FontFamily="Consolas" Text="—"/>
                                </StackPanel>
                                <Path Grid.Column="1" Data="M4 12h14m-5-5 5 5-5 5" Stroke="#64718E" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="18" Height="18" Stretch="Uniform" Margin="10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="VpnIpLabel" FontSize="9.5" Foreground="#64718E" Text="IP ЧЕРЕЗ VPN"/>
                                    <TextBlock x:Name="VpnIpText" FontSize="14.5" FontWeight="SemiBold" Foreground="#8EC2FF" Margin="0,2,0,0"
                                               FontFamily="Consolas" Text="—"/>
                                </StackPanel>
                                <Button Grid.Column="3" x:Name="BtnRefreshIp" Style="{DynamicResource GhostButton}" Click="BtnRefreshIp_Click"
                                        VerticalAlignment="Center" Content="Обновить"/>
                            </Grid>
                        </Border>

                        <!-- metrics -->
                        <UniformGrid Columns="4" Margin="0,10,0,0" Rows="1">
                            <Border x:Name="MetricDown" CornerRadius="11" Background="#08FFFFFF" BorderBrush="#1B2540" BorderThickness="1"
                                    Padding="8,7" Margin="0,0,7,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="25" Height="25" CornerRadius="8" Background="#243B82F6" VerticalAlignment="Center">
                                        <Path Data="M12 4v12m0 0 5-5m-5 5-5-5" Stroke="#7DB3FF" StrokeThickness="2" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="DownValue" FontSize="12.5" FontWeight="Bold" Foreground="#EAF0FF" Text="0.0"/>
                                        <TextBlock x:Name="DownLabel" FontSize="9" Foreground="#64718E" Text="Мбит/с ↓"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="MetricUp" CornerRadius="11" Background="#08FFFFFF" BorderBrush="#1B2540" BorderThickness="1"
                                    Padding="8,7" Margin="0,0,7,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="25" Height="25" CornerRadius="8" Background="#248B5CF6" VerticalAlignment="Center">
                                        <Path Data="M12 20V8m0 0 5 5m-5-5-5 5" Stroke="#B9A3FF" StrokeThickness="2" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="UpValue" FontSize="12.5" FontWeight="Bold" Foreground="#EAF0FF" Text="0.0"/>
                                        <TextBlock x:Name="UpLabel" FontSize="9" Foreground="#64718E" Text="Мбит/с ↑"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="MetricTime" CornerRadius="11" Background="#08FFFFFF" BorderBrush="#1B2540" BorderThickness="1"
                                    Padding="8,7" Margin="0,0,7,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="25" Height="25" CornerRadius="8" Background="#24F59E0B" VerticalAlignment="Center">
                                        <Path Data="M12 7v5l3 2" Stroke="#F6C66A" StrokeThickness="2" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TimeValue" FontSize="12.5" FontWeight="Bold" Foreground="#EAF0FF" Text="00:00"/>
                                        <TextBlock x:Name="TimeLabel" FontSize="9" Foreground="#64718E" Text="Сессия"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="MetricTraffic" CornerRadius="11" Background="#08FFFFFF" BorderBrush="#1B2540" BorderThickness="1"
                                    Padding="8,7">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="25" Height="25" CornerRadius="8" Background="#2422C55E" VerticalAlignment="Center">
                                        <Path Data="M7 4h7l4 4v12H7V4Z" Stroke="#7FE0A4" StrokeThickness="2" StrokeLineJoin="Round"
                                              Width="12" Height="12" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TrafficValue" FontSize="12.5" FontWeight="Bold" Foreground="#EAF0FF" Text="0"/>
                                        <TextBlock x:Name="TrafficLabel" FontSize="9" Foreground="#64718E" Text="МБ"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- country picker -->
                    <Border Grid.Row="1" x:Name="PickerPanel" CornerRadius="14,14,0,0" Background="#B30D1426"
                            BorderBrush="#1B2540" BorderThickness="1,1,1,0">
                        <Grid Margin="16,12,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- header -->
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="PickerTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="#EAF0FF" Text="Выбор страны"/>
                                    <Border x:Name="ServerCountBadge" CornerRadius="9" Background="#293B82F6" BorderBrush="#3378AAFF"
                                            BorderThickness="1" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ServerCountText" FontSize="10.5" FontWeight="Bold" Foreground="#93C5FD" Text="0"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border x:Name="SearchBox" Width="188" Height="30" CornerRadius="9" Background="#0DFFFFFF"
                                            BorderBrush="#1B2540" BorderThickness="1" Padding="9,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="M11 4.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13Zm4.6 11.1 4 4"
                                                  Stroke="#64718E" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBox x:Name="SearchInput" Grid.Column="1" Margin="7,0,0,0" Background="Transparent" BorderThickness="0"
                                                     Foreground="#EAF0FF" CaretBrush="#3B82F6" FontSize="12.5" VerticalAlignment="Center"
                                                     TextChanged="SearchInput_TextChanged"/>
                                            <Button Grid.Column="2" x:Name="SearchClearBtn" Style="{DynamicResource TinyIconButton}"
                                                    Click="SearchClearBtn_Click" Visibility="Collapsed">
                                                <Path Data="m6.4 5 5.6 5.6L17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19 5 17.6 10.6 12 5 6.4 6.4 5Z"
                                                      Fill="#64718E" Width="11" Height="11" Stretch="Uniform"/>
                                            </Button>
                                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Margin="7,0,0,0" FontSize="12.5"
                                                       Foreground="#64718E" VerticalAlignment="Center" IsHitTestVisible="False" Text="Найти страну"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="BtnSmart" Style="{DynamicResource ChipButton}" Click="BtnSmart_Click" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M13 2 4.5 13.5H11L10 22l8.5-11.5H12L13 2Z" Fill="#FBBF24" Width="12" Height="12"
                                                  Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SmartText" Margin="5,0,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#FBBF24"
                                                       Text="Умный выбор" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- tabs -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,11,0,7">
                                <Button x:Name="TabAll" Style="{DynamicResource TabButton}" Click="Tab_Click" Tag="all" Content="Все"/>
                                <Button x:Name="TabFast" Style="{DynamicResource TabButton}" Click="Tab_Click" Tag="fast" Content="Быстрые"/>
                                <Button x:Name="TabFavorite" Style="{DynamicResource TabButton}" Click="Tab_Click" Tag="favorite" Content="Избранные"/>
                                <Button x:Name="TabNearby" Style="{DynamicResource TabButton}" Click="Tab_Click" Tag="nearby" Content="Рядом"/>
                            </StackPanel>

                            <Border Grid.Row="2" Height="1" Background="#141B2540" Margin="0,0,0,4"/>

                            <!-- list -->
                            <Grid Grid.Row="3">
                                <ScrollViewer x:Name="CountryScroll" Style="{DynamicResource OverlayScrollViewer}"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,4,0" CanContentScroll="False">
                                    <StackPanel x:Name="CountryList"/>
                                </ScrollViewer>

                                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="🌐" FontSize="30" HorizontalAlignment="Center" Opacity="0.75"/>
                                    <TextBlock x:Name="EmptyTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="#EAF0FF"
                                               HorizontalAlignment="Center" Margin="0,9,0,0" Text="Ничего не найдено"/>
                                    <TextBlock x:Name="EmptyHint" FontSize="11.5" Foreground="#64718E" HorizontalAlignment="Center"
                                               Margin="0,3,0,0" Text="Попробуйте изменить запрос"/>
                                </StackPanel>

                                <StackPanel x:Name="SkeletonPanel" Visibility="Collapsed">
                                    <Border Height="42" CornerRadius="10" Background="#0CFFFFFF" Margin="0,0,0,4"/>
                                    <Border Height="42" CornerRadius="10" Background="#0CFFFFFF" Margin="0,0,0,4"/>
                                    <Border Height="42" CornerRadius="10" Background="#0CFFFFFF" Margin="0,0,0,4"/>
                                    <Border Height="42" CornerRadius="10" Background="#0CFFFFFF" Margin="0,0,0,4"/>
                                    <Border Height="42" CornerRadius="10" Background="#0CFFFFFF" Margin="0,0,0,4"/>
                                    <Border Height="42" CornerRadius="10" Background="#0CFFFFFF" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Grid>

                            <!-- footer -->
                            <Grid Grid.Row="4" Margin="0,6,0,9">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="BtnRefreshList" Style="{DynamicResource LinkButton}" Click="BtnRefreshList_Click"
                                            Content="Обновить список серверов"/>
                                    <TextBlock Text="·" Foreground="#3D4A66" Margin="7,0" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBlock x:Name="LastUpdatedText" FontSize="10.5" Foreground="#64718E" VerticalAlignment="Center"
                                               Text="ещё не обновляли"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============ settings sheet ============ -->
            <Grid x:Name="SettingsOverlay" Visibility="Collapsed">
                <Border x:Name="SettingsBackdrop" Background="#B303060E" MouseLeftButtonDown="SettingsBackdrop_Click"/>
                <Border x:Name="SettingsSheet" Width="340" HorizontalAlignment="Right" Background="#0B1120"
                        BorderBrush="#1B2540" BorderThickness="1,0,0,0" RenderTransformOrigin="1,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SettingsSlide" X="0"/>
                    </Border.RenderTransform>
                    <Grid Margin="18,14,18,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock x:Name="SettingsTitle" FontSize="15" FontWeight="SemiBold" Foreground="#EAF0FF" Text="Настройки"/>
                            <Button HorizontalAlignment="Right" Style="{DynamicResource IconButton}" Click="BtnCloseSettings_Click">
                                <Path Data="m6.4 5 5.6 5.6L17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19 5 17.6 10.6 12 5 6.4 6.4 5Z"
                                      Fill="#93A0BD" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,16">
                            <StackPanel x:Name="SettingsBody"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ log drawer ============ -->
            <Border x:Name="LogDrawer" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="10" MaxHeight="300"
                    CornerRadius="12" Background="#F2050A13" BorderBrush="#1B2540" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="12,8,8,6">
                        <TextBlock x:Name="LogTitle" FontSize="11.5" Foreground="#93A0BD" Text="Журнал подключения"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCopyLog" Style="{DynamicResource LinkButton}" Click="BtnCopyLog_Click" Content="Копировать"/>
                            <Button Style="{DynamicResource IconButton}" Click="BtnCloseLog_Click" Margin="4,0,0,0">
                                <Path Data="m6.4 5 5.6 5.6L17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19 5 17.6 10.6 12 5 6.4 6.4 5Z"
                                      Fill="#64718E" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0,8,8">
                        <TextBox x:Name="LogText" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#9FB0CF"
                                 FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" IsUndoEnabled="False"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============ admin modal ============ -->
            <Grid x:Name="AdminOverlay" Visibility="Collapsed" Background="#C003060E">
                <Border Width="380" CornerRadius="18" Background="#0C1322" BorderBrush="#1B2540" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🛡" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AdminTitle" FontSize="16" FontWeight="SemiBold" Foreground="#EAF0FF" HorizontalAlignment="Center"
                                   Margin="0,8,0,8" Text="Нужны права администратора"/>
                        <TextBlock x:Name="AdminText" FontSize="12.5" Foreground="#93A0BD" TextWrapping="Wrap" TextAlignment="Center"
                                   LineHeight="19" Margin="0,0,0,16"/>
                        <Button x:Name="BtnRestartAdmin" Style="{DynamicResource PrimaryButton}" Click="BtnRestartAdmin_Click"
                                Content="Перезапустить от администратора" Margin="0,0,0,8"/>
                        <Button x:Name="BtnAdminLater" Style="{DynamicResource LinkButton}" Click="BtnAdminLater_Click" Content="Позже"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ toasts ============ -->
            <StackPanel x:Name="ToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,14,14"
                        IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
